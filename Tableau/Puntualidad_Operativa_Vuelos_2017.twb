    <dashboard name="2. Regimenes de puntualidad">
      <style>
        <style-rule element='dash-container'>
          <format attr='background-color' id='dash-zone_1' value='#F6F8F8' />
        </style-rule>
      </style>
      <size maxheight='900' maxwidth='1500' minheight='900' minwidth='1500' />
      <zones>
        <zone h='100000' id='1' type-v2='layout-basic' w='100000' x='0' y='0'>
        <zone h='6500' id='2' type-v2='text' w='100000' x='0' y='0'>
          <formatted-text>
            <run fontcolor='#16211F' fontsize='18' bold='true'>La demora es bimodal: la media no describe a nadie</run>
          </formatted-text>
          <zone-style>
            <format attr='background-color' value='#F6F8F8' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='4' />
          </zone-style>
        </zone>
        <zone h='4500' id='3' type-v2='text' w='100000' x='0' y='6500'>
          <formatted-text>
            <run fontcolor='#6E7C77' fontsize='11'>95,2% de los vuelos sale con 15 minutos o menos  ·  entre 16 y 59 minutos no hay ninguno</run>
          </formatted-text>
          <zone-style>
            <format attr='background-color' value='#F6F8F8' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='4' />
          </zone-style>
        </zone>
