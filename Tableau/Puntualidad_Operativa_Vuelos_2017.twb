    <column datatype='integer' name="[Orden de dia]" role='dimension' type='ordinal' />
    <column datatype='string' name="[Tipo de dia]" role='dimension' type='nominal' />
    <column datatype='string' name="[Franja]" role='dimension' type='nominal' />
    <column datatype='integer' name="[Orden de franja]" role='dimension' type='ordinal' />
    <column datatype='string' name="[Aeronave]" role='dimension' type='nominal' />
    <column datatype='string' name="[Alcance]" role='dimension' type='nominal' />
    <column datatype='string' name="[Regimen]" role='dimension' type='nominal' />
    <column datatype='integer' name="[Orden de regimen]" role='dimension' type='ordinal' />
    <column datatype='string' name="[Origen]" role='dimension' type='nominal' />
    <column datatype='string' name="[Destino]" role='dimension' type='nominal' />
    <column datatype='string' name="[Ruta]" role='dimension' type='nominal' />
    <column datatype='integer' name="[N operados]" role='measure' type='quantitative' />
    <column datatype='integer' name="[N puntuales]" role='measure' type='quantitative' />
    <column datatype='integer' name="[Minutos de demora]" role='measure' type='quantitative' />
    <column datatype='integer' name="[N con llegada]" role='measure' type='quantitative' />
    <column datatype='real' name="[Minutos recuperados]" role='measure' type='quantitative' />
    <column datatype='integer' name="[Minutos programados]" role='measure' type='quantitative' />
    <column datatype='real' name="[Minutos reales]" role='measure' type='quantitative' />
    <column caption="% de la programacion operado" datatype='real' default-format="p0.0%" name='[TasaCobertura]' role='measure' type='quantitative'>
      <calculation class='tableau' formula="SUM([N operados]) / SUM([N vuelos])" scope-isolation='false' />
    </column>
    <column caption="% de vuelos cancelados" datatype='real' default-format="p0.00%" name='[TasaCancelacion]' role='measure' type='quantitative'>
      <calculation class='tableau' formula="SUM([N cancelados]) / SUM([N vuelos])" scope-isolation='false' />
    </column>
    <column caption="Demora media de salida (min)" datatype='real' default-format="n#,##0.00" name='[DemoraMedia]' role='measure' type='quantitative'>
      <calculation class='tableau' formula="SUM([Minutos de demora]) / SUM([N operados])" scope-isolation='false' />
    </column>
    <column caption="% de vuelos puntuales" datatype='real' default-format="p0.0%" name='[TasaPuntualidad]' role='measure' type='quantitative'>
      <calculation class='tableau' formula="SUM([N puntuales]) / SUM([N operados])" scope-isolation='false' />
    </column>
    <column caption="Recuperacion media en ruta (min)" datatype='real' default-format="n#,##0.000" name='[RecuperacionMedia]' role='measure' type='quantitative'>
      <calculation class='tableau' formula="SUM([Minutos recuperados]) / SUM([N con llegada])" scope-isolation='false' />
    </column>
    <column caption="% de los minutos de demora" datatype='real' default-format="p0.00%" name='[PctDemora]' role='measure' type='quantitative'>
      <calculation class='tableau' formula="SUM([Minutos de demora]) / TOTAL(SUM([Minutos de demora]))" scope-isolation='false' />
    </column>
    <column caption="Regimen de puntualidad" datatype='string' name='[RegimenPuntualidad]' role='dimension' type='nominal'>
      <calculation class='tableau' formula="STR([Orden de regimen]) + '. ' + [Regimen]" scope-isolation='false' />
    </column>
    <column caption="Franja horaria" datatype='string' name='[FranjaOrdenada]' role='dimension' type='nominal'>
      <calculation class='tableau' formula="STR([Orden de franja]) + '. ' + [Franja]" scope-isolation='false' />
    </column>
    <column caption="Dia de la semana" datatype='string' name='[DiaOrdenado]' role='dimension' type='nominal'>
      <calculation class='tableau' formula="STR([Orden de dia]) + '. ' + [Dia]" scope-isolation='false' />
    </column>
    <column-instance column='[RegimenPuntualidad]' derivation='None' name="[none:RegimenPuntualidad:nk]" pivot='key' type='nominal' />
    <column-instance column='[FranjaOrdenada]' derivation='None' name="[none:FranjaOrdenada:nk]" pivot='key' type='nominal' />
    <column-instance column='[DiaOrdenado]' derivation='None' name="[none:DiaOrdenado:nk]" pivot='key' type='nominal' />
    <layout dim-ordering='alphabetic' measure-ordering='alphabetic' show-structure='true' />
    <style>
      <style-rule element='mark'>
        <encoding attr='color' field="[none:RegimenPuntualidad:nk]" type='palette'>
          <map to='#2e9e7b'>
            <bucket>&quot;1. Salida puntual&quot;</bucket>
          </map>
          <map to='#7fbf7b'>
            <bucket>&quot;2. Demora minima&quot;</bucket>
          </map>
          <map to='#ffb020'>
            <bucket>&quot;3. Demora leve&quot;</bucket>
          </map>
          <map to='#e8734a'>
            <bucket>&quot;4. Demora moderada&quot;</bucket>
          </map>
          <map to='#d93636'>
            <bucket>&quot;5. Demora severa&quot;</bucket>
          </map>
        </encoding>
      </style-rule>
    </style>
