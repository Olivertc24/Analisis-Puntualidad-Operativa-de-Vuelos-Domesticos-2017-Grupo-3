            <column datatype='integer' name="[Minutos de demora]" role='measure' type='quantitative' />
            <column-instance column="[Aeronave]" derivation='None' name="[none:Aeronave:nk]" pivot='key' type='nominal' />
            <column-instance column="[Mes]" derivation='None' name="[none:Mes:nk]" pivot='key' type='nominal' />
            <column-instance column="[Alcance]" derivation='None' name="[none:Alcance:nk]" pivot='key' type='nominal' />
